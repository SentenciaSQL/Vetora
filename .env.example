# Lunaveta environment

Copy these variables into Railway (API service) or a local `.env` file.
Never commit real secrets.

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/animalin
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Frontend origin used in verification, password-reset and invite links
FRONTEND_URL=https://lunaveta.com
PUBLIC_APP_URL=https://lunaveta.com

# Resend transactional email (REST API, no SMTP)
# Create an API key in Resend and verify the lunaveta.com domain.
# In Railway: service → Variables → add the keys below.
RESEND_API_KEY=
RESEND_FROM=LunaVeta <no-reply@lunaveta.com>
RESEND_API_URL=https://api.resend.com

# Firebase Cloud Messaging (API service on Railway)
# FCM_ENABLED=false lets the API start without Firebase.
# When true, both FIREBASE_PROJECT_ID and FIREBASE_SERVICE_ACCOUNT_BASE64 are required.
# Generate the Base64 value locally and paste it only into Railway. Do not commit it.
#   Linux:   base64 -w 0 firebase-service-account.json
#   macOS:   base64 -i firebase-service-account.json | tr -d '\n'
# The JSON is the Firebase Admin service account key (Project settings → Service accounts).
# It is an admin credential and must never be shipped in the Flutter app.
FCM_ENABLED=false
FIREBASE_PROJECT_ID=lunaveta-68cc1
FIREBASE_SERVICE_ACCOUNT_BASE64=
